echar', { duration: 4000 });\n        this.router.navigate(['/entrar']);\n        this.isLoading = false;\n      },\n      error: (error) => {\n        console.error('Erro ao solicitar redefinição de password:', error);\n        this.snackbar.open('Erro ao enviar e-mail. Verifique se o e-mail está correto.', 'Fechar', { duration: 3000 });\n        this.isLoading = false;\n      }\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/features/home/pages/home/home-about-us/home-about-us.component.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/features/home/pages/home/home-about-us/home-about-us.component.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/features/home/pages/home/home-about-us/home-about-us.component.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/features/home/pages/home/home-banner/home-banner.component.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/features/home/pages/home/home-banner/home-banner.component.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/vinici