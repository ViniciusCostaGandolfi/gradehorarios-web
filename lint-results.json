: 'root'\n})\nexport class SolucoesService {\n  private apiUrl = `${environment.GRADEHORARIOS_API}/api/institutions`;\n  private http = inject(HttpClient);\n\n  getAll(): Observable<SolutionDto[]> {\n    return this.http.get<SolutionDto[]>(`${this.apiUrl}/solutions`);\n  }\n\n\n  get(instituicaoId: number, solucaoId: number): Observable<SolutionDto> {\n    return this.http.get<SolutionDto>(`${this.apiUrl}/${instituicaoId}/solutions/${solucaoId}`);\n  }\n\n\n  create(instituicaoId: number, file: File): Observable<SolutionDto> {\n    const formData = new FormData()\n    formData.append('file', file)\n    return this.http.post<SolutionDto>(`${this.apiUrl}/${instituicaoId}/solutions`, formData);\n  }\n\n  delete(instituicaoId: number, solucaoId: number): Observable<void> {\n    return this.http.delete<void>(`${this.apiUrl}/${instituicaoId}/solutions/${solucaoId}`);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/core/services/validate-images/validate-images.service.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/core/services/validate-images/validate-images.service.ts","messages":[{"ruleId":"@typescript-eslint/no-useless-constructor","severity":2,"message":"Useless constructor.","line":11,"column":3,"nodeType":"MethodDefinition","messageId":"noUselessConstructor","endLine":11,"endColumn":20,"suggestions":[{"messageId":"removeConstructor","fix":{"range":[282,299],"text":""},"desc":"Remove the constructor."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":38,"column":23,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":38,"endColumn":32,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[1018,1019],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-empty-function","severity":2,"message":"Unexpected empty constructor.","line":11,"column":17,"nodeType":"FunctionExpression","messageId":"unexpected","endLine":11,"endColumn":20,"suggestions":[{"messageId":"suggestComment","data":{"name":"constructor"},"fix":{"range":[297,298],"text":" /* empty */ "},"desc":"Add comment inside empty constructor."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Injectable } from '@angular/core';\nimport { from,Observable } from 'rxjs';\nimport { mergeMap, toArray } from 'rxjs/operators';\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class ValidateImagesService {\n\n  // eslint-disable-next-line @typescript-eslint/no-empty-function\n  constructor() { }\n\n  hasValid(files: File[]): boolean {\n    for (const file of files) {\n      if (file.type !== 'image/png') {\n        alert('Apenas imagens .png são aceitas.');\n        return false;\n      }\n      if (file.size > 20 * 1024 * 1024) {\n        alert('O tamanho da imagem não pode exceder 20MB.');\n        return false;\n      }\n    }\n    return true;\n  }\n\n  toBase64(files: File[]): Observable<string[]> {\n    return from(files).pipe(\n      mergeMap(file => this.readFileAsBase64(file)),\n      toArray()\n    );\n  }\n\n  private readFileAsBase64(file: File): Observable<string> {\n    return new Observable<string>(observer => {\n      const reader = new FileReader();\n      reader.onload = e => {\n        observer.next(e.target!.result as string);\n        observer.complete();\n      };\n      reader.onerror = error => { observer.error(error); };\n      reader.readAsDataURL(file);\n    });\n  }\n}\n","usedDeprecatedRu