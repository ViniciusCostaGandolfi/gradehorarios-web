":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":12,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { HttpClient } from '@angular/common/http';\nimport { inject, Injectable } from '@angular/core';\nimport type { Observable} from 'rxjs';\nimport { tap } from 'rxjs';\n\nimport { environment } from '../../../../environments/environment';\nimport type { UserCreation, UserLogin } from '../../interfaces/auth';\nimport { CurrentlyUserService } from '../currently-user/currently-user.service';\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class AuthService {\n\n  private apiUrl: string = environment.GRADEHORARIOS_API;\n  \n  private http = inject(HttpClient);\n  private currentlyUserService = inject(CurrentlyUserService);\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  createUser(user: UserCreation): Observable<any> {\n    const url = `${this.apiUrl}/api/auth/sigin`;\n\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    return this.http.post<any>(url, user, { observe: 'response' }).pipe(\n      tap(response => {\n        const authToken = response.body?.token;\n        if (authToken) {\n          this.currentlyUserService.saveToken(authToken);\n        }\n      })\n    );\n  }\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  login(userLogin: UserLogin): Observable<any> {\n    const url = `${this.apiUrl}/api/auth/login`;\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    return this.http.post<any>(url, userLogin, { observe: 'response' }).pipe(\n      tap(response => {\n        const authToken = response.body?.token;\n        if (authToken) {\n          this.currentlyUserService.saveToken(authToken);\n        }\n      })\n    );\n  }\n\n  refreshToken():void {\n    const url = `${this.apiUrl}/auth/refresh_token`;\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    this.http.post<any>(url, { observe: 'response' }).pipe(\n      tap(response => {\n        const authToken = response.body?.token;\n        if (authToken) {\n          this.currentlyUserService.saveToken(authToken);\n        } else {\n          this.currentlyUserService.logout()\n        }\n      })\n    );\n\n  }\n\n\n  requestPasswordReset(email: string): Observable<string> {\n    const url = `${this.apiUrl}/api/auth/forgot_password`;\n    return this.http.post(url, { email }, { responseType: 'text' });\n  }\n\n\n  resetPassword(payload: { token: string, newPassword: string }): Observable<string> {\n    const url = `${this.apiUrl}/api/auth/reset_password`;\n    return this.http.post(url, payload, { responseType: 'text' });\n  }\n\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  loginWithGoogle(token: string): Observable<any> {\n    const url = `${this.apiUrl}/api/auth/google`;\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    return this.http.post<any>(url, { token }, { observe: 'response' }).pipe(\n      tap(response => {\n        const authToken = response.body?.token;\n        if (authToken) {\n          this.currentlyUserService.saveToken(authToken);\n        }\n      })\n    );\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/vinicius/Documents/grade-horarios/gradehorarios-web/src/app/core/services/currently-user/currently-user.service.ts","messages":[{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":2,"message":"Missing return type on function.","line":22,"column":3,"nodeType":"FunctionExpression","messageId":"missingReturnType","endLine":22,"endColumn":20},{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":2,"message":"Missing return type on function.","line":28,"column":3,"nodeType":"FunctionExpression","messageId":"missingReturnType","endLine":28,"endColumn":10},{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":2,"message":"Missing return type on function.","line":32,"column":3,"nodeType":